# Python
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/
# virtual environments (start_*.bat create .venv, .venv-control, .venv-dev, .venv-analysis)
.venv*/
# runtime output of the simulator, tests and IOC hosts
sim/logs/
sim/data/
sim/backup/
tests/hwtest_logs/
ioc_host/logs/
*.log
*.out
# generated by start_control_host.py from the live environment
control/qserver/existing_plans_and_devices.yaml
# this PC's own config (real addresses etc.) - created from the tracked *.example.yaml on first start
control/lab.yaml
control/lab_*.yaml
!control/lab_sim.yaml
ioc_host/supervisor_config.yaml
ioc_host/hosts/*.yaml
!ioc_host/hosts/*.example.yaml
# local Channel Access access-security file (ioc_host/common/access_control.py)
ioc_host/security.yaml
# private notes (host names, accounts, addresses) - never in this public repository
HANDOFF.local.md
*.local.md
# local snapshots from before git
backups/
